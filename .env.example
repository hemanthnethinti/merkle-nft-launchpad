# =============================================================================
# NFT Launchpad - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# Local Development (Hardhat)
# -----------------------------------------------------------------------------
# Contract address deployed on local Hardhat network (auto-generated)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Local Hardhat RPC URL
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Chain ID for Hardhat local network
NEXT_PUBLIC_CHAIN_ID=31337

# -----------------------------------------------------------------------------
# Testnet Deployment (Sepolia)
# -----------------------------------------------------------------------------
# Sepolia RPC URL (get from Infura, Alchemy, etc.)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key for deployment (DO NOT COMMIT REAL KEYS!)
PRIVATE_KEY=your_testnet_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# -----------------------------------------------------------------------------
# IPFS Upload (Pinata)
# -----------------------------------------------------------------------------
# Pinata API credentials for metadata upload
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key

# -----------------------------------------------------------------------------
# Gas Reporting (Optional)
# -----------------------------------------------------------------------------
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
